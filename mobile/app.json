{
  "expo": {
    "name": "Axten HR",
    "slug": "axten-hr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "axtenhr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.axtenos.hr",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Axten HR uses your location to verify you are at the workplace when you punch in or out."
      }
    },
    "android": {
      "package": "com.axtenos.hr",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Axten HR uses your location to verify you are at the workplace when you punch in or out."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0B1220",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4f9a4d42-e8b4-41fc-a4ff-daae96e735bb"
      }
    }
  }
}
