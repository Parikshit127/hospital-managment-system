{
    "framework": "nextjs",
    "buildCommand": "npx prisma generate && next build",
    "installCommand": "npm ci --no-audit --no-fund",
    "regions": ["bom1"],
    "crons": [
        {
            "path": "/api/ipd/bed-cleaning-sla",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/mis/worker",
            "schedule": "* * * * *"
        },
        {
            "path": "/api/cron/mis-scheduled-delivery",
            "schedule": "30 1 * * *"
        },
        {
            "path": "/api/cron/mis-rollup",
            "schedule": "30 18 * * *"
        },
        {
            "path": "/api/cron/inventory-reorder",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/inventory-expiry-alerts",
            "schedule": "0 6 * * *"
        }
    ]
}
