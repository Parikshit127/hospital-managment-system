  // investigations, procedure, operative notes, course, meds, instructions, follow-up,
  // condition, prepared/verified by, + any header overrides). `generated_summary` keeps a
  // rendered text version for backward-compatible consumers (e.g. the older PDF route).
  data              Json?
  prepared_by       String?
  updated_at        DateTime     @default(now()) @updatedAt
  organizationId    String
  created_at        DateTime     @default(now())
  admission         admissions   @relation(fields: [admission_id], references: [admission_id])
