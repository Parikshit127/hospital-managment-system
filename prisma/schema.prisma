model IpdChargePosting {
  id              Int          @id @default(autoincrement())
  admission_id    String
  invoice_item_id Int?
  source_module   String
  source_ref_id   String?
  description     String
  amount          Decimal
  posted_by       String?
  posted_at       DateTime     @default(now())
  organizationId  String
  is_backdated    Boolean      @default(false)
  // Two-ledger package billing (all additive; existing rows keep semantics via defaults):
  //   'billed'            → normal invoice line (invoice_item_id set)
  //   'package_consumed'  → absorbed under an active package (invoice_item_id NULL, never claimed)
  //   'billable_extra'    → package exclusion billed over the package (invoice_item_id set)
  disposition          String   @default("billed")
  admission_package_id Int?
  service_category     String?
  quantity             Float    @default(1)
  unit_price           Decimal  @default(0)
  tax_rate             Decimal  @default(0)
  rendered_by_doctor_id String? // User.id — carried into invoice_items if/when this posting is reclassified to billable
  organization         Organization         @relation(fields: [organizationId], references: [id])
  admission_package    IpdAdmissionPackage? @relation(fields: [admission_package_id], references: [id])

  @@index([admission_id])
  @@index([organizationId])
  @@index([admission_package_id])
  @@index([admission_id, disposition])
  @@map("ipd_charge_postings")
}

