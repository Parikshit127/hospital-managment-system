  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("denial_reasons")
}

// Short-pay / disallowance ledger — every disallowed amount with its disposition.
model ClaimShortPay {
  id                 Int       @id @default(autoincrement())
  claim_id           Int?
  invoice_id         Int
  amount             Decimal   @default(0)
  denial_reason_code String?
  disposition        String    @default("PendingReview") // PendingReview | ToRecover | WriteOff | Resubmit
  resolved_by        String?
  resolved_at        DateTime?
  gl_posted          Boolean   @default(false)
  organizationId     String
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  invoice      invoices          @relation(fields: [invoice_id], references: [id])
  claim        insurance_claims? @relation(fields: [claim_id], references: [id])

