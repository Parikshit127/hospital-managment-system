model insurance_claims {
  id                    Int       @id @default(autoincrement())
  claim_number          String    @unique
  policy_id             Int
  invoice_id            Int
  admission_id          String?
  claimed_amount        Decimal
  approved_amount       Decimal?
  rejected_amount       Decimal?
  status                String    @default("Submitted")
  rejection_reason      String?
  zealthix_claim_number String?
  action_status         String?
  settled_amount        Decimal?
  tds_amount            Decimal?
  zealthix_remarks      String?
  zealthix_attachments  Json?
  organizationId        String
  submitted_at          DateTime  @default(now())
  reviewed_at           DateTime?
  settled_at            DateTime?
  // TPA upgrade — sanction reconciliation, denial taxonomy, resubmission & SLA
  sanctioned_amount     Decimal?
  short_pay_amount      Decimal?
  denial_reason_code    String?
  resubmission_count    Int       @default(0)
  original_claim_id     Int? // self-link: a resubmitted claim points to the original
  appeal_status         String? // null | Appealed | AppealApproved | AppealRejected
  dispatch_id           String?
  sla_due_at            DateTime?

  organization        Organization                 @relation(fields: [organizationId], references: [id])
  policy              insurance_policies           @relation(fields: [policy_id], references: [id])
  invoice             invoices                     @relation(fields: [invoice_id], references: [id])
  admission           admissions?                  @relation(fields: [admission_id], references: [admission_id])
  original_claim      insurance_claims?            @relation("ClaimResubmission", fields: [original_claim_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resubmissions       insurance_claims[]           @relation("ClaimResubmission")
  dispatches          ClaimDispatch[]
  short_pays          ClaimShortPay[]
  receipt_allocations InsuranceReceiptAllocation[]

  @@index([organizationId])
  @@index([invoice_id])
  @@index([status])
}

