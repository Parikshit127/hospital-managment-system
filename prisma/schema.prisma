model IpdAdmissionPackage {
  id             Int          @id @default(autoincrement())
  admission_id   String
  package_id     Int
  applied_amount Decimal
  // Snapshot of the resolved display name (TPA override or master name) at the
  // moment this package was applied — so later name edits don't retroactively
  // change already-billed paperwork. Null on rows applied before this field existed.
  applied_package_name String?
  is_broken_open Boolean      @default(false)
  broken_at      DateTime?
  applied_by     String?
  organizationId String
  created_at     DateTime     @default(now())
  // Two-ledger package billing: explicit lifecycle. 'active' | 'broken_open' | 'closed'.
  // Supersedes is_broken_open (kept for backward compatibility).
  status         String       @default("active")
  closed_at      DateTime?
  // Rolling "Package Absorbed Cost" expense for this admission package (if any).
  expense_id     Int?
  admission      admissions   @relation(fields: [admission_id], references: [admission_id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  package        IpdPackage   @relation(fields: [package_id], references: [id])
