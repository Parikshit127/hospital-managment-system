generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  code       String   @unique
  address    String?
  phone      String?
  email      String?
  license_no String?
  logo_url   String?
  is_active  Boolean  @default(true)
  plan       String   @default("free") // free, starter, pro, enterprise
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  config   OrganizationConfig?
  branding OrganizationBranding?

  users                         User[]
  patients                      OPD_REG[]
  appointments                  appointments[]
  clinical_ehrs                 Clinical_EHR[]
  vital_signs                   vital_signs[]
  triage_results                triage_results[]
  lab_orders                    lab_orders[]
  lab_test_inventory            lab_test_inventory[]
  lab_panels                    LabPanel[]
  lab_staff                     lab_staff[]
  radiology_imaging             radiology_imaging[]
  lab_audit_logs                lab_audit_logs[]
  pharmacy_medicine_master      pharmacy_medicine_master[]
  pharmacy_orders               pharmacy_orders[]
  pharmacy_sales_audit          pharmacy_sales_audit[]
  admissions                    admissions[]
  medical_notes                 medical_notes[]
  patient_notes                 PatientNote[]
  discharge_summaries           discharge_summaries[]
  beds                          beds[]
  wards                         wards[]
  invoices                      invoices[]
  invoice_items                 invoice_items[]
  payments                      payments[]
  payment_order_intents         PaymentOrderIntent[]
  charge_catalog                charge_catalog[]
  insurance_providers           insurance_providers[]
  ipd_package_tpa_rates         IpdPackageTpaRate[]
  insurance_policies            insurance_policies[]
  insurance_claims              insurance_claims[]
  system_audit_logs             system_audit_logs[]
  user_mfa_records              user_mfa[]
  patient_password_setup_tokens PatientPasswordSetupToken[]
  ai_health_assessments         AiHealthAssessment[]
  appointment_slots             AppointmentSlot[]
  departments                   Department[]
  prescription_templates        PrescriptionTemplate[]
  follow_ups                    FollowUp[]
  lab_sample_tracking           LabSampleTracking[]
  lab_reagent_inventory         LabReagentInventory[]
  pharmacy_suppliers            PharmacySupplier[]
  purchase_orders               PurchaseOrder[]
  goods_receipt_notes           GoodsReceiptNote[]
  pharmacy_returns              PharmacyReturn[]
  ward_stock                    WardStock[]
  ward_stock_transactions       WardStockTransaction[]
  bed_transfers                 BedTransfer[]
  diet_plans                    DietPlan[]
  ward_rounds                   WardRound[]
  nursing_tasks                 NursingTask[]
  patient_feedbacks             PatientFeedback[]
  cash_closures                 CashClosure[]
  refunds                       Refund[]
  // Phase 3 models
  nursing_notes                 NursingNote[]
  medication_administrations    MedicationAdministration[]
  shift_handovers               ShiftHandover[]
  employees                     Employee[]
  attendances                   Attendance[]
  leave_types                   LeaveType[]
  leave_requests                LeaveRequest[]
  shift_patterns                ShiftPattern[]
  shift_assignments             ShiftAssignment[]
  notifications                 Notification[]
  tickets                       Ticket[]
  ticket_notes                  TicketNote[]
  release_notes                 ReleaseNote[]
  broadcasts                    Broadcast[]
  notification_receipts         NotificationReceipt[]
  expense_categories            ExpenseCategory[]
  vendors                       Vendor[]
  expenses                      Expense[]
  tax_configs                   TaxConfig[]
  patient_deposits              PatientDeposit[]
  credit_notes                  CreditNote[]
  financial_periods             FinancialPeriod[]
  bank_transactions             BankTransaction[]
  dunning_rules                 DunningRule[]
  dunning_logs                  DunningLog[]
  ipd_service_masters           IpdServiceMaster[]
  ipd_tariff_rates              IpdTariffRate[]
  ipd_packages                  IpdPackage[]
  ipd_admission_packages        IpdAdmissionPackage[]
  ipd_estimates                 IpdEstimate[]
  ipd_charge_postings           IpdChargePosting[]
  branches                      Branch[]
  // Admin panel dynamic configuration
  module_configs                ModuleConfig[]
  custom_roles                  Role[]
  document_templates            DocumentTemplate[]
  alert_rules                   AlertRule[]
  // Data import & archival
  data_import_jobs              DataImportJob[]
  archived_patient_records      ArchivedPatientRecord[]
  // Zealthix insurance integration
  zealthix_api_keys             ZealthixApiKey[]
  pill_reminders                PillReminder[]
  message_delivery_logs         MessageDeliveryLog[]
  whatsapp_incoming_msgs        WhatsAppIncomingMessage[]
  video_call_requests           VideoCallRequest[]
  // Phase 1 — Corporate & Pre-Authorization
  corporate_masters             CorporateMaster[]
  // Phase 2 — Payment Splits
  payment_splits                PaymentSplit[]
  // Phase 3 — EMR
  clinical_encounters           ClinicalEncounter[]
  patient_allergies             PatientAllergy[]
  // IPD Upgrade
  ipd_vitals                    IPDVitals[]
  nursing_assessments           NursingAssessment[]
  insurance_preauths            InsurancePreAuth[]
  admission_consultants         AdmissionConsultant[]
  // Finance: GST Compliance
  gst_invoice_register          GST_Invoice_Register[]
  gst_return_filings            GST_Return_Filing[]
  hsn_sac_master                HSN_SAC_Master[]
  // Finance: General Ledger & Tally Integration
  gl_accounts                   GL_Account[]
  gl_journal_entries            GL_JournalEntry[]
  gl_journal_lines              GL_JournalLine[]
  tally_exports                 TallyExport[]
  // Finance: Fixed Asset Management
  asset_categories              AssetCategory[]
  fixed_assets                  FixedAsset[]
  depreciation_entries          DepreciationEntry[]
  asset_transfers               AssetTransfer[]
  asset_maintenance             AssetMaintenance[]
  // Finance: Budget Management
  budget_masters                BudgetMaster[]
  budget_lines                  BudgetLine[]
  budget_revisions              BudgetRevision[]
  budget_alerts                 BudgetAlert[]

  // GAP 5 — 2-Hour Assessment Alerts
  nursing_assessment_alerts      NursingAssessmentAlert[]
  // GAP 6 — 14-Tab IPD EMR
  clinical_orders                ClinicalOrder[]
  physician_orders               PhysicianOrder[]
  hospital_type                  String?
  bed_capacity                   Int?
  accreditation_body             String?
  accreditation_number           String?
  accreditation_expiry           DateTime?
  registration_number            String?
  registration_authority         String?
  established_year               Int?
  organization_gstin             String?
  gst_state_code                 String?
  website                        String?
  specialties                    String[]                      @default([])
  latitude                       Float?
  longitude                      Float?
  admission_bookings             AdmissionBooking[]
  appointment_waitlists          AppointmentWaitlist[]
  billing_order_sets             BillingOrderSet[]
  crm_campaigns                  CRMCampaign[]
  crm_leads                      CRMLead[]
  call_logs                      CallLog[]
  counselling_sessions           CounsellingSession[]
  discharge_clearances           DischargeClearance[]
  discount_otps                  DiscountOTP[]
  discount_schemes               DiscountScheme[]
  doctor_leaves                  DoctorLeave[]
  doctor_referrals               DoctorReferralNetwork[]
  financial_counsellings         FinancialCounselling[]
  narcotic_registers             NarcoticRegister[]
  patient_consents_ipd           PatientConsent_IPD[]
  patient_engagements            PatientEngagement[]
  patient_movements              PatientMovement[]
  registration_field_configs     RegistrationFieldConfig[]
  active_medications             ActiveMedication[]
  ambulance_requests             ambulance_requests[]
  dispense_allocations           DispenseAllocation[]
  doctor_investigation_favorites DoctorInvestigationFavorite[]
  er_registrations               ERRegistration[]
  indents                        indents[]
  inventory_movements            inventory_movements[]
  item_batches                   item_batches[]
  item_categories                item_categories[]
  item_master                    item_master[]
  item_vendors                   item_vendors[]
  mis_daily_billing_rollups      mis_daily_billing_rollups[]
  mis_daily_pharmacy_rollups     mis_daily_pharmacy_rollups[]
  optical_orders                 optical_orders[]
  optical_prescriptions          optical_prescriptions[]
  order_sets                     OrderSet[]
  ot_rooms                       OTRoom[]
  ot_schedules                   OTSchedule[]
  pharmacy_inventory_movements   PharmacyInventoryMovement[]
  pharmacy_purchase_invoices     PharmacyPurchaseInvoice[]
  purchase_requisitions          purchase_requisitions[]
  referral_orders                ReferralOrder[]
  report_access_logs             report_access_logs[]
  report_jobs                    report_jobs[]
  report_presets                 report_presets[]
  report_schedules               report_schedules[]
  stock_adjustments              stock_adjustments[]
  stock_count_sessions           stock_count_sessions[]
  stock_issues                   stock_issues[]
  stock_transfers                stock_transfers[]
  store_item_settings            store_item_settings[]
  store_stocks                   store_stocks[]
  stores                         stores[]
  surgery_masters                SurgeryMaster[]
  surgery_requests               SurgeryRequest[]
  writeoffs                      Writeoff[]

  // Referral & Commission
  referrers                  Referrer[]
  referrer_service_rates     ReferrerServiceRate[]
  referral_commissions       ReferralCommission[]
  referral_payout_statements ReferralPayoutStatement[]

  // Doctor Commission
  doctor_commission_configs DoctorCommissionConfig[]
  doctor_service_rates      DoctorServiceRate[]
  doctor_commissions        DoctorCommission[]
  doctor_payout_statements  DoctorPayoutStatement[]

  // TPA & Insurance Upgrade — receipts, dispatch, denial taxonomy, short-pay, SLA
  insurance_receipts            InsuranceReceipt[]
  insurance_receipt_allocations InsuranceReceiptAllocation[]
  claim_dispatches              ClaimDispatch[]
  denial_reasons                DenialReason[]
  claim_short_pays              ClaimShortPay[]
  payer_sla_configs             PayerSlaConfig[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  branch_name    String
  branch_code    String
  address        String?
  city           String?
  state          String?
  pincode        String?
  phone          String?
  email          String?
  is_main_branch Boolean      @default(false)
  is_active      Boolean      @default(true)
  latitude       Float?
  longitude      Float?
  organizationId String
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  stores         stores[]
  tickets        Ticket[]
  broadcasts     Broadcast[]

  @@index([organizationId])
  @@map("branches")
}

model SubscriptionPlan {
  id                     String   @id @default(uuid())
  plan_name              String
  plan_code              String   @unique
  max_users              Int      @default(0)
  max_branches           Int      @default(0)
  max_patients_per_month Int?
  features               String[] @default([])
  price_monthly          Float    @default(0)
  price_yearly           Float    @default(0)
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("subscription_plans")
}

model OrganizationConfig {
  id                            String       @id @default(uuid())
  organizationId                String       @unique
  uhid_prefix                   String       @default("AVN")
  timezone                      String       @default("Asia/Kolkata")
  currency                      String       @default("INR")
  date_format                   String       @default("DD/MM/YYYY")
  session_timeout               Int          @default(15)
  enable_whatsapp               Boolean      @default(false)
  enable_razorpay               Boolean      @default(false)
  enable_ai_triage              Boolean      @default(true)
  razorpay_key_id               String?
  razorpay_key_secret           String?
  smtp_host                     String?
  smtp_user                     String?
  smtp_pass                     String?
  smtp_port                     Int?
  smtp_secure                   String?
  whatsapp_api_token            String?
  whatsapp_phone_id             String?
  whatsapp_webhook_verify_token String?
  whatsapp_app_secret           String?
  openai_key                    String?
  sms_gateway_url               String?
  sms_api_key                   String?
  sms_sender_id                 String?
  sender_phone_number           String?
  tally_enabled                 Boolean      @default(false)
  tally_url                     String?
  tally_company                 String?
  tally_username                String?
  tally_password                String?
  tally_auto_sync               Boolean      @default(false)
  tally_last_sync_at            DateTime?
  tally_voucher_type_map        String?

  // Fallback flat commission % applied to doctors who have NO DoctorCommissionConfig.
  // 0 = disabled (unconfigured doctors accrue nothing). Drives the default-rate
  // accrual in app/lib/doctor-commission.ts.
  default_doctor_commission_percent Float @default(0)

  organization                  Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_configs")
}

model OrganizationBranding {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  primary_color    String       @default("#10b981")
  secondary_color  String       @default("#0f172a")
  logo_url         String?
  portal_title     String       @default("Hospital OS")
  portal_subtitle  String       @default("Management System")
  footer_text      String?
  letterhead_url   String?
  header_height    Int          @default(130)
  footer_height    Int          @default(80)
  accent_color     String       @default("#1e3a6e")
  tagline          String?
  terms_conditions String?
  signature_title  String?
  signature_name   String?
  organization     Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_brandings")
}

model ModuleConfig {
  id             String       @id @default(uuid())
  organizationId String
  module_key     String
  enabled        Boolean      @default(true)
  config_json    Json         @default("{}")
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, module_key])
  @@index([organizationId])
  @@map("module_configs")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  is_system      Boolean      @default(false)
  is_active      Boolean      @default(true)
  permissions    Json         @default("[]")
  data_scope     String       @default("own")
  description    String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  action      String
  label       String
  description String?

  @@map("permissions")
}

model DocumentTemplate {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  name           String
  content_json   Json         @default("{}")
  is_default     Boolean      @default(false)
  is_active      Boolean      @default(true)
  created_by     String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, type, name])
  @@index([organizationId])
  @@map("document_templates")
}

model AlertRule {
  id             String       @id @default(uuid())
  organizationId String
  category       String
  trigger_key    String
  name           String
  enabled        Boolean      @default(true)
  channels       Json         @default("[\"in_app\"]")
  recipients     Json         @default("{}")
  threshold      Json?
  escalation     Json?
  template       String?
  quiet_hours    Json?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("alert_rules")
}

model SuperAdmin {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("super_admins")
}

model User {
  id                                                      String               @id @default(uuid())
  username                                                String               @unique
  password                                                String
  role                                                    String
  is_dev_admin                                            Boolean              @default(false)
  is_developer                                            Boolean              @default(false)
  name                                                    String?
  specialty                                               String?
  email                                                   String?
  phone                                                   String?
  assigned_ward_id                                        Int?
  branch_id                                               String?
  doctor_registration_no                                  String?
  qualifications                                          String?
  organizationId                                          String
  is_active                                               Boolean              @default(true)
  working_hours                                           String               @default("09:00-17:00")
  slot_duration                                           Int                  @default(20)
  consultation_fee                                        Float                @default(500)
  follow_up_fee                                           Float                @default(300)
  max_overbooking_per_slot                                Int                  @default(0)
  gender                                                  String?
  working_days                                            String?
  max_patients_per_day                                    Int?
  createdAt                                               DateTime             @default(now())
  supervisor_id                                           String?
  doctor_group_id                                         String?
  is_group_lead                                           Boolean              @default(false)
  employee_code                                           String?
  designation                                             String?
  department                                              String?
  date_of_joining                                         DateTime?
  appointment_slots                                       AppointmentSlot[]
  employee_profile                                        Employee?
  report_access_logs                                      report_access_logs[]
  report_jobs                                             report_jobs[]
  report_presets                                          report_presets[]
  report_schedules                                        report_schedules[]
  stock_transfers_stock_transfers_dispatch_user_idTousers stock_transfers[]    @relation("stock_transfers_dispatch_user_idTousers")
  stock_transfers_stock_transfers_receive_user_idTousers  stock_transfers[]    @relation("stock_transfers_receive_user_idTousers")
  stores                                                  stores[]
  tickets                                                 Ticket[]             @relation("TicketCreator")
  assigned_tickets                                        Ticket[]             @relation("TicketAssignee")
  notifications                                           Notification[]
  ticket_notes                                            TicketNote[]
  broadcasts_created                                      Broadcast[]
  notification_receipts                                   NotificationReceipt[]
  organization                                            Organization         @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([doctor_group_id])
  @@index([branch_id])
  @@map("users")
}

model OPD_REG {
  id                         Int       @id @default(autoincrement())
  patient_id                 String    @unique
  full_name                  String
  age                        String?
  gender                     String?
  phone                      String?
  email                      String?
  address                    String?
  department                 String?
  aadhar_card                String?
  emergency_contact_name     String?
  emergency_contact_phone    String?
  emergency_contact_relation String?
  blood_group                String?
  date_of_birth              String?
  registration_consent       Boolean   @default(false)
  profile_photo_url          String?
  allergies                  String?
  chronic_conditions         String?
  abha_number                String?
  abha_address               String?
  pan_number                 String?
  employee_id                String?
  registration_number        String?
  organizationId             String
  password                   String?
  is_archived                Boolean   @default(false)
  archived_at                DateTime?
  created_at                 DateTime  @default(now())

  // Phase 1 — Patient Type Classification
  patient_type          String  @default("cash") // cash | corporate | tpa_insurance
  corporate_id          String?
  corporate_card_number String?

  // GAP 1 — UHID Merging / Unmerging
  parent_patient_id String? // Primary UHID if this is secondary
  is_secondary      Boolean   @default(false)
  merged_into       String? // Tracks merge history
  merged_at         DateTime?
  merged_by         String?

  // GAP 13 — Registration Fields Missing
  title                     String? // Baby, Dr, Mrs, Mr, Ms
  is_vip                    Boolean @default(false)
  marital_status            String? // Single, Married, Divorced, Widowed
  preferred_language        String? @default("en") // en, hi, ar, etc.
  lead_source               String? // Hospital, Doctor, Website, Social Media, Referral
  race                      String? // For Arab nation patients
  patient_category          String? // Antenatal, BPL, General, Govt Employee, Postnatal
  frro_number               String? // Required for international patients
  is_senior_citizen         Boolean @default(false)
  age_in_days               Int? // For newborns
  registration_remarks      String?
  distance_from_hospital_km Float?
  registration_form_url     String? // Signed form upload

  // Referral & Commission — who referred this patient (null = Self / walk-in)
  referrer_id String?

  organization          Organization                @relation(fields: [organizationId], references: [id])
  referrer              Referrer?                   @relation(fields: [referrer_id], references: [id])
  corporate             CorporateMaster?            @relation(fields: [corporate_id], references: [id])
  appointments          appointments[]
  admissions            admissions[]
  invoices              invoices[]
  insurance_policies    insurance_policies[]
  feedbacks             PatientFeedback[]
  password_setup_tokens PatientPasswordSetupToken[]
  pill_reminders        PillReminder[]
  video_call_requests   VideoCallRequest[]
  whatsapp_logs         whatsapp_log[]
  // Phase 3 — EMR
  clinical_encounters   ClinicalEncounter[]
  patient_allergies     PatientAllergy[]
  patient_notes         PatientNote[]
  city                  String?
  country               String?                     @default("India")
  govt_id_number        String?
  govt_id_type          String?
  nationality           String?
  pincode               String?
  state                 String?

  @@index([organizationId])
  @@index([organizationId, is_archived])
  @@index([created_at])
  @@index([organizationId, created_at])
  @@index([patient_type])
  @@index([organizationId, city])
  @@index([organizationId, pincode])
  @@index([organizationId, referrer_id])
}

// Free-text notes attached to a patient (added at admission/registration or
// from the patient profile). Timestamped history, newest-first in the UI.
model PatientNote {
  id              Int      @id @default(autoincrement())
  patient_id      String
  note            String
  source          String?  @default("profile") // admission | registration | profile
  created_by      String? // author username (from session)
  created_by_name String? // author display name (from session)
  created_by_role String? // author role (from session)
  organizationId  String
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      OPD_REG      @relation(fields: [patient_id], references: [patient_id])

  @@index([organizationId])
  @@index([patient_id])
  @@index([organizationId, patient_id])
}

model appointments {
  id                    Int          @id @default(autoincrement())
  appointment_id        String       @unique
  patient_id            String
  doctor_name           String?
  doctor_id             String?
  department            String?
  status                String       @default("Pending")
  reason_for_visit      String?
  cancellation_reason   String?
  follow_up_date        DateTime?
  organizationId        String
  queue_token           Int?
  checked_in_at         DateTime?
  called_at             DateTime?
  appointment_date      DateTime     @default(now())
  reminder24Sent        Boolean      @default(false)
  slot_id               String?      @unique
  appointment_type      String       @default("NEW_OPD")
  parent_appointment_id String?
  booking_channel       String?      @default("walk_in")
  payment_mode          String       @default("ONLINE")
  payment_status        String       @default("PENDING")
  is_pav                Boolean      @default(false)
  pav_sms_sent          Boolean      @default(false)
  priority              String?      @default("Regular")
  recurrence_rule       Json?
  organization          Organization @relation(fields: [organizationId], references: [id])
  patient               OPD_REG      @relation(fields: [patient_id], references: [patient_id])

  @@index([organizationId])
  @@index([status])
  @@index([patient_id])
  @@index([appointment_date])
  @@index([doctor_id])
  @@index([booking_channel])
  @@index([appointment_type])
  @@index([payment_mode])
}

model Clinical_EHR {
  appointment_id String       @id
  patient_id     String
  doctor_name    String?
  diagnosis      String?
  doctor_notes   String?
  organizationId String
  is_archived    Boolean      @default(false)
  archived_at    DateTime?
  created_at     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, is_archived])
}

model VideoCallRequest {
  id               String       @id @default(uuid())
  patient_id       String
  doctor_id        String
  request_date     DateTime     @default(now())
  status           String       @default("Pending")
  scheduled_at     DateTime?
  meet_link        String?
  reason           String?
  rejection_reason String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  patient          OPD_REG      @relation(fields: [patient_id], references: [patient_id])

  @@index([organizationId])
  @@index([patient_id])
  @@index([doctor_id])
  @@map("video_call_requests")
}

model lab_orders {
  id                     Int          @id @default(autoincrement())
  barcode                String       @unique
  patient_id             String
  doctor_id              String
  test_type              String
  status                 String
  result_value           String?
  technician_remarks     String?
  report_url             String?
  assigned_technician_id String?
  is_critical            Boolean      @default(false)
  critical_notified_at   DateTime?
  organizationId         String
  is_archived            Boolean      @default(false)
  archived_at            DateTime?
  created_at             DateTime     @default(now())
  organization           Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
