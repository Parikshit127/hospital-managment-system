model invoices {
  id                       Int       @id @default(autoincrement())
  // Bill number — assigned only when the bill is finalized (Draft -> Final). Drafts
  // are numberless (null). Finalized bills continue the ongoing OPD/IPD series.
  invoice_number           String?   @unique
  // Legacy "Final Bill No." series (ORG-BILL-...). No longer assigned; the finalized
  // number now lives in invoice_number. Kept nullable for historical rows only.
  final_bill_number        String?   @unique
  patient_id               String
  admission_id             String?
  invoice_type             String    @default("OPD")
  // Marks OPD "fee receipt" bills (quick OPD counter receipts / inline OPD bills).
  // Replaces the old invoice_type == 'OPD_FEE' discriminator so those bills display
  // under the plain "OPD" type while staying identifiable for the Fee Receipts
  // screens, OPD dashboard and patient history.
  is_fee_receipt           Boolean   @default(false)
  total_amount             Decimal   @default(0)
  total_discount           Decimal   @default(0)
  net_amount               Decimal   @default(0)
  paid_amount              Decimal   @default(0)
  balance_due              Decimal   @default(0)
  status                   String    @default("Draft")
  notes                    String?
  organizationId           String
  is_archived              Boolean   @default(false)
  archived_at              DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  finalized_at             DateTime?
  total_tax                Decimal   @default(0)
  cgst_amount              Decimal   @default(0)
  sgst_amount              Decimal   @default(0)
  igst_amount              Decimal   @default(0)
  is_inter_state           Boolean   @default(false)
  estimate_id              Int?
  approved_by              String?
  approved_at              DateTime?
  version                  Int       @default(1)
  billing_patient_type     String    @default("cash")
  corporate_id             String?
  tpa_provider_id          Int?
  pre_auth_id              String?
  patient_payable          Decimal   @default(0)
  corporate_payable        Decimal   @default(0)
  tpa_payable              Decimal   @default(0)
  tpa_claim_status         String    @default("not_submitted")
  tpa_claim_number         String?
  tpa_settled_amount       Decimal   @default(0)
  // TPA approval lifecycle — separates "what TPA promised" (immutable anchor)
  // from "what we've actually received" (accumulator in tpa_settled_amount).
  tpa_approved_amount      Decimal   @default(0)
  tpa_approved_at          DateTime?
  tpa_settled_at           DateTime?
  // TPA receipt reconciliation — disallowed (short-pay) + TDS deducted by payer.
  // Identity once fully processed: tpa_settled_amount + tpa_disallowed_amount + tpa_tds_amount = tpa_approved_amount.
  tpa_disallowed_amount    Decimal   @default(0)
  tpa_tds_amount           Decimal   @default(0)
  corporate_invoice_number String?
  concession_amount        Decimal   @default(0)
  concession_reason        String?
  concession_approved_by   String?

  // Phase 6 — Addendum Invoices
  is_addendum       Boolean @default(false)
  parent_invoice_id String?
  addendum_reason   String?

  // Cancellation tracking
  cancelled_at        DateTime?
  cancelled_by        String?
  cancellation_reason String?

  // Prescribing doctor
  doctor_id   String?
  doctor_name String?

  // Discounts and TPA
  bill_discount Decimal @default(0)
  discount_remark String?

  // Hard edit-lock
  is_locked Boolean   @default(false)
  locked_at DateTime?
  locked_by String?

  // Relations
  organization          Organization                 @relation(fields: [organizationId], references: [id])
  patient               OPD_REG                      @relation(fields: [patient_id], references: [patient_id])
  admission             admissions?                  @relation(fields: [admission_id], references: [admission_id])
  items                 invoice_items[]
  snapshots             invoice_snapshots[]
  payments              payments[]
  payment_order_intents PaymentOrderIntent[]
  insurance_claims      insurance_claims[]
  credit_notes          CreditNote[]
  payment_splits        PaymentSplit[]
  pharmacy_orders       pharmacy_orders[]
  writeoffs             Writeoff[]
  receipt_allocations   InsuranceReceiptAllocation[]
  claim_short_pays      ClaimShortPay[]

  @@index([organizationId])
  @@index([status])
  @@index([patient_id])
  @@index([billing_patient_type])
  @@index([created_at])
  @@index([organizationId, is_archived])
  @@index([organizationId, billing_patient_type, tpa_claim_status])
}

model invoice_items {
  id               Int          @id @default(autoincrement())
  invoice_id       Int
  department       String
  description      String
  quantity         Float        @default(1)
  unit_price       Decimal
  total_price      Decimal
  discount         Decimal      @default(0)
  net_price        Decimal
  ref_id           String?
