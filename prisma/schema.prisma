// ============================================================
// Referral & Commission
// A referrer sends patients to the hospital and earns commission on the
// business those patients generate. Internal-only — never shown on bills,
// receipts, the patient portal, or any clinical screen.
// ============================================================

model Referrer {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?

  // staff | affiliate | interpreter | rmp | others  (self is implicit — never stored)
  category String @default("others")

  // Payout / compliance details
  pan_number   String?
  bank_account String?
  ifsc         String?

  // commission_type: flat_percent | per_service | fixed_per_patient
  commission_type          String @default("flat_percent")
  flat_percent             Float? // used when commission_type = flat_percent
  fixed_amount_per_patient Float? // used when commission_type = fixed_per_patient

  is_active  Boolean  @default(true)
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id])
  service_rates ReferrerServiceRate[]
  commissions   ReferralCommission[]
  statements    ReferralPayoutStatement[]
  patients      OPD_REG[]

  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, is_active])
  @@map("referrers")
}

model ReferrerServiceRate {
  id             String @id @default(uuid())
  organizationId String
  referrer_id    String
  // matches invoices.invoice_type: OPD | IPD | Pharmacy | Lab | Procedure
  service_type   String
  // See DoctorServiceRate.service_name — "" = whole bucket, a name = that one service.
  service_name   String @default("")
  percent        Float  @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  referrer     Referrer     @relation(fields: [referrer_id], references: [id], onDelete: Cascade)

  @@unique([referrer_id, service_type, service_name])
  @@index([organizationId])
  @@map("referrer_service_rates")
}

model ReferralCommission {
  id             String @id @default(uuid())
  organizationId String
  referrer_id    String
  patient_id     String
  invoice_id     Int
  invoice_type   String

  eligible_base     Decimal @default(0) // collected amount this commission is computed on
  rate_applied      Float   @default(0) // percent (0 for fixed_per_patient rows)
  commission_amount Decimal @default(0)

  // accrued | included_in_statement | paid | void
  status       String  @default("accrued")
  statement_id String?

  accrued_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id])
  referrer     Referrer                 @relation(fields: [referrer_id], references: [id])
  statement    ReferralPayoutStatement? @relation(fields: [statement_id], references: [id])

  @@unique([invoice_id])
  @@index([organizationId])
  @@index([referrer_id, status])
  @@index([patient_id])
  @@index([statement_id])
  @@map("referral_commissions")
}

model ReferralPayoutStatement {
  id             String   @id @default(uuid())
  organizationId String
  referrer_id    String
  // Human-readable consultant-charge invoice number, e.g. AVS-CNI-26-27-001.
  statement_number String? @unique
  period_start   DateTime
  period_end     DateTime

  total_commission Decimal @default(0)
  // draft | finalized | paid
  status           String  @default("draft")

  paid_at           DateTime?
  paid_amount       Decimal?
  payment_mode      String?
  payment_reference String?
  notes             String?
  created_by        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  referrer     Referrer             @relation(fields: [referrer_id], references: [id])
  lines        ReferralCommission[]

  @@index([organizationId, referrer_id])
  @@map("referral_payout_statements")
}

// ============================================================
// Doctor Commission
// Commission earned by the doctor assigned to a bill (invoices.doctor_id),
// computed per-bill on the collected amount. Doctors are User records;
// invoice.doctor_id = User.id. Internal-only — Admin/Finance.
// ============================================================

model DoctorCommissionConfig {
  id             String @id @default(uuid())
  organizationId String
  doctor_id      String // User.id

  // commission_type: flat_percent | per_service | fixed_per_bill
  commission_type       String @default("flat_percent")
  flat_percent          Float? // used when flat_percent
  fixed_amount_per_bill Float? // used when fixed_per_bill

  // Payout / compliance details
  pan_number   String?
  bank_account String?
  ifsc         String?

  is_active  Boolean  @default(true)
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id])
  service_rates DoctorServiceRate[]

  @@unique([organizationId, doctor_id])
  @@index([organizationId])
  @@map("doctor_commission_configs")
}

model DoctorServiceRate {
  id             String @id @default(uuid())
  organizationId String
  doctor_id      String
  // matches invoices.invoice_type: OPD | IPD | Pharmacy | Lab | Procedure
  service_type   String
  // Optional named service (matches invoice_items.description / ipd_service_master.service_name).
  // "" = the rate applies to the whole service_type bucket; a name = a rate for that
  // one service only, which overrides the bucket rate on lines matching it.
  service_name   String @default("")
  percent        Float  @default(0)

  organization Organization           @relation(fields: [organizationId], references: [id])
  config       DoctorCommissionConfig @relation(fields: [organizationId, doctor_id], references: [organizationId, doctor_id], onDelete: Cascade)

  @@unique([doctor_id, service_type, service_name])
  @@index([organizationId])
  @@index([organizationId, doctor_id])
  @@map("doctor_service_rates")
}

model DoctorCommission {
  id             String @id @default(uuid())
  organizationId String
  doctor_id      String
  patient_id     String
  invoice_id     Int
  invoice_type   String

  eligible_base     Decimal @default(0) // collected amount this commission is computed on
  rate_applied      Float   @default(0) // percent (0 for fixed_per_bill rows)
  commission_amount Decimal @default(0)

  // TDS withheld by the hospital before paying the doctor (Section 194J on
  // professional fees). Stamped at invoice-raise time from the statement's rate,
  // so each line carries its own share for audit/traceability even though the
  // rate itself is set once per statement.
  tds_rate_percent Float   @default(10)
  tds_amount       Decimal @default(0)

  // accrued | included_in_statement | paid | void
  status       String  @default("accrued")
  statement_id String?

  accrued_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  statement    DoctorPayoutStatement? @relation(fields: [statement_id], references: [id])

  // One row per doctor per bill — a bill can now pay commission to more than
  // one doctor when some line items carry their own rendered_by_doctor_id
  // (see invoice_items.rendered_by_doctor_id) distinct from invoices.doctor_id.
  @@unique([invoice_id, doctor_id])
  @@index([organizationId])
  @@index([doctor_id, status])
  @@index([patient_id])
  @@index([statement_id])
  @@map("doctor_commissions")
}

model DoctorPayoutStatement {
  id             String   @id @default(uuid())
  organizationId String
  doctor_id      String
  // Human-readable doctor invoice number, e.g. AVS-DRI-26-27-001. Nullable so the
  // pre-existing rows created before numbering was introduced stay valid.
  statement_number String? @unique
  period_start   DateTime
  period_end     DateTime

  total_commission Decimal @default(0)
  // TDS withheld under Section 194J before paying the doctor. net_payable =
  // total_commission - total_tds; that's the amount actually transferred, and
  // what paid_amount defaults to when the statement is marked paid.
  tds_rate_percent Float   @default(10)
  total_tds        Decimal @default(0)
  net_payable      Decimal @default(0)
  // draft | finalized | paid
  status           String  @default("draft")

  paid_at           DateTime?
  paid_amount       Decimal?
  payment_mode      String?
  payment_reference String?
  notes             String?
  created_by        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  lines        DoctorCommission[]

  @@index([organizationId, doctor_id])
  @@map("doctor_payout_statements")
}

// ========================================
// MODULE — TPA & Insurance Upgrade (Finance Receivables)
// Receipts & advice reconciliation, dispatch, denial taxonomy, short-pay, SLA.
// Additive to the existing insurance_* / invoices / PaymentSplit / GL models.
// ========================================

// A single payer remittance / advice. One receipt is allocated across many bills
// via InsuranceReceiptAllocation. The benchmark "Insurance Receipts" + "unmapped
// receipt" concepts live here.
model InsuranceReceipt {
  id               Int      @id @default(autoincrement())
  receipt_number   String // org-unique, e.g. AXT-IRC-26-27-001
  payer_type       String // tpa_insurance | corporate
  provider_id      Int? // when payer_type = tpa_insurance
  corporate_id     String? // when payer_type = corporate
  instrument       String   @default("NEFT") // NEFT | RTGS | Cheque | UPI | Other
  reference_number String // UTR / cheque no — unique per org
  receipt_date     DateTime
  total_amount     Decimal  @default(0) // amount actually received (net of TDS/service charge/disallowance)
  allocated_amount Decimal  @default(0)
  unmapped_amount  Decimal  @default(0) // total_amount - allocated_amount (the "unmapped receipt")
  tds_total        Decimal  @default(0)
  // Settlement-advice breakdown (MEDNET-style): claim − sanctioned = disallowed;
  // sanctioned − tds_total − service_charge = total_amount (received).
  claim_amount      Decimal @default(0) // gross amount claimed from the payer
  sanctioned_amount Decimal @default(0) // amount the payer approved
  service_charge    Decimal @default(0) // TPA service charge deducted from the sanctioned amount
  status           String   @default("Open") // Open | PartiallyAllocated | Allocated | Reversed
  remarks          String?
  gl_posted        Boolean  @default(false)
  organizationId   String
  created_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id])
  provider     insurance_providers?         @relation(fields: [provider_id], references: [id])
  corporate    CorporateMaster?             @relation(fields: [corporate_id], references: [id])
  allocations  InsuranceReceiptAllocation[]

  @@unique([organizationId, receipt_number])
  // Uniqueness on reference_number is enforced by a PARTIAL unique index
  // (WHERE status <> 'Reversed'), created in
  // 20260723000000_insurance_receipt_reference_partial_unique. Prisma cannot
  // express a partial index, so this is a plain index here and the constraint
  // lives in the migration — a reversed receipt must release its UTR so the
  // corrected receipt can be re-recorded under the real one.
  @@index([organizationId, reference_number])
  @@index([organizationId])
  @@index([payer_type])
  @@index([status])
  @@map("insurance_receipts")
}

// One line of a receipt applied to one bill (invoice/claim): how much was
// received, disallowed (short-pay) and TDS, with the linked payment row.
model InsuranceReceiptAllocation {
  id                  Int      @id @default(autoincrement())
  receipt_id          Int
  invoice_id          Int
  claim_id            Int?
  allocated_amount    Decimal  @default(0)
  disallowed_amount   Decimal  @default(0)
  tds_amount          Decimal  @default(0)
  disallowance_reason String? // FK code into DenialReason.code (soft ref)
  payment_id          Int? // the payments row created for this allocation
  payment_split_id    String? // the PaymentSplit row, if used
  organizationId      String
  created_at          DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  receipt      InsuranceReceipt  @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  invoice      invoices          @relation(fields: [invoice_id], references: [id])
  claim        insurance_claims? @relation(fields: [claim_id], references: [id])

  @@index([organizationId])
  @@index([receipt_id])
  @@index([invoice_id])
  @@map("insurance_receipt_allocations")
}

// Cover-letter + dispatch register entry for a submitted claim.
model ClaimDispatch {
  id               String    @id @default(uuid())
  claim_id         Int
  dispatch_mode    String    @default("Portal") // Portal | Email | Courier | Hand
  reference_awb    String?
  cover_letter_key String? // S3 key for the generated cover letter PDF
  dispatched_by    String?
  dispatched_at    DateTime  @default(now())
  ack_received     Boolean   @default(false)
  ack_date         DateTime?
  remarks          String?
  organizationId   String
  created_at       DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  claim        insurance_claims @relation(fields: [claim_id], references: [id])

  @@index([organizationId])
  @@index([claim_id])
  @@map("claim_dispatches")
}

// Configurable denial / disallowance reason library.
model DenialReason {
